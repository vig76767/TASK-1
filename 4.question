import java.util.Scanner;
public class Main
{
	public static void main(String[] args) {
		Scanner scan = new Scanner(System.in);
		int num = scan.nextInt();
		int num2 = scan.nextInt();
		int num3 = scan.nextInt();
		int num4=0;
		if(num<=num2){
		    num4=num;
		}else{
		   num4=num2; 
		
		}
		 if(num4>=num3){
		     num4=num3;
		 }
		 
		 System.out.print("Smallest number: "+num4);
		 
	}
}
